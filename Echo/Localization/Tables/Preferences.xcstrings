    "menuBarIntervalCaption" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While the popover or a window is open, polling uses the usual interval from System Monitoring. This one is for when only the menu bar is visible: a longer interval saves battery."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока открыт поповер или окно, опрос идёт с обычным интервалом из раздела System Monitoring. Этот — для случая, когда виден только трей: реже опрос, меньше расход батареи."
          }
        }
      }
    },
    "menuBarIntervalTitle" : {
      "extractionState" : "manual",
