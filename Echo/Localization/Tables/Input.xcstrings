    "accessibilityMissingCaption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable %1$@ in System Settings → Privacy & Security → Accessibility. The status here updates automatically."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите %1$@ в System Settings → Privacy & Security → Accessibility. Статус обновится здесь автоматически."
          }
        }
      }
    },
