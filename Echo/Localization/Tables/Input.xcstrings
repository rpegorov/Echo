      }
    },
    "tilingConflictTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conflict with macOS Tiling"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Конфликт с тайлингом macOS"
          }
        }
      }
    },
    "tilingConflictCaption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS system tiling also snaps windows to the edges. Turn it off to avoid a conflict."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Системный тайлинг macOS тоже магнитит окна к краям. Отключите его, чтобы не было конфликта."
          }
        }
      }
    },
    "disableSystemTilingButton": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disable macOS Tiling"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключить тайлинг macOS"
          }
        }
      }
    },
    "ultraSwitchTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ultra Switch"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ultra Switch"
          }
        }
      }
    },
    "ultraSwitchEnableTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Ultra Switch"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включить Ultra Switch"
          }
        }
      }
    },
    "ultraSwitchEnableCaption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Layout hotkeys instead of the 🌐 key: switch layout, convert the last word, translate the selection."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хоткеи раскладки вместо клавиши 🌐: переключение раскладки, конвертация последнего слова, перевод выделенного."
          }
        }
      }
    },
    "autoConvertTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-Correct Layout"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоисправление раскладки"
          }
        }
      }
    },
    "autoConvertCaption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After a space, a word like “ghbdtn” becomes “привет” on its own and the layout switches. Works independently of Ultra Switch's hotkeys; the decision comes from the system's ru and en dictionaries."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После пробела слово вроде «ghbdtn» само станет «привет», а раскладка переключится. Работает независимо от хоткеев Ultra Switch; решение принимают системные словари ru и en."
          }
        }
      }
    },
    "privacyNoteCaption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keystrokes are not recorded: the app only sees the code of the separator key, and reads the word from its own typing buffer at the moment of checking. No typing history is ever stored, and password fields are ignored."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажатия клавиш не записываются: приложение видит только код клавиши-разделителя, а слово читает из собственного буфера набранного в момент проверки. История набора нигде не хранится, поля паролей игнорируются."
          }
        }
      }
    },
    "statusRunningTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-correct is on"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автозамена активна"
          }
        }
      }
    },
    "statusDisabledTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-correct is off"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автозамена выключена"
          }
        }
      }
    },
    "statusNeedsInputMonitoringTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Input Monitoring access needed"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужен доступ Input Monitoring"
          }
        }
      }
    },
    "statusRunningDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A word typed in the wrong layout is corrected after a space."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слово, набранное не в той раскладке, исправляется после пробела."
          }
        }
      }
    },
    "statusDisabledDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on auto-correct layout above."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите автоисправление раскладки выше."
          }
        }
      }
    },
    "statusNeedsAccessibilityDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without it, the correction can't reach another app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без него исправление не дойдёт до чужого приложения."
          }
        }
      }
    },
    "statusNeedsInputMonitoringDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without it, there's nothing to compare the typed word against."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без него не видно, что вы набираете, и слово не с чем сравнивать."
          }
        }
      }
    },
    "afterUpdateHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After an update, macOS treats it as a different app — remove Echo from the list with “−” and add it again. The status here will update on its own."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если Echo уже есть в списке после обновления — удалите его кнопкой «−» и добавьте заново. Статус здесь обновится сам."
          }
        }
      }
    },
    "allowButton": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить"
          }
        }
      }
    },
    "singleLayoutWarning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only one layout is enabled on this system — there's nothing to switch. Add a second one in System Settings → Keyboard → Input Sources."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В системе включена только одна раскладка — переключать нечего. Добавьте вторую в System Settings → Keyboard → Input Sources."
          }
        }
      }
    },
    "conversionUndoCaption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Converting the same word again puts it back — that's how you undo an auto-correction."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторная конвертация того же слова возвращает его обратно — это и есть отмена автоисправления."
          }
        }
      }
    },
    "translationCaption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translation runs on-device via macOS: the selected text is replaced with a translation into the other language of the ru/en pair. Nothing goes over the network, and the clipboard is restored afterward."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевод работает на устройстве средствами macOS: выделенный текст заменяется переводом на другой язык из пары ru/en. В сеть ничего не уходит, буфер обмена возвращается на место."
          }
        }
      }
    },
    "snippetsTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snippets"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сниппеты"
          }
        }
      }
    },
    "snippetsHowItWorksTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How it works"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как это работает"
          }
        }
      }
    },
    "snippetsHowItWorksCaption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type an abbreviation, press space — it's replaced with the text you set. Case and layout don't matter: “ЬЬ” matches the “mm” snippet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Набираете сокращение, ставите пробел — на его месте оказывается заданный текст. Регистр и раскладка не важны: «ЬЬ» найдёт сниппет «mm»."
          }
        }
      }
    },
    "snippetsDisabledWarning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not working right now: snippets use the same typing interception as auto-correct layout. Turn on auto-correct layout in the Ultra Switch section."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас не работает: сниппеты используют тот же перехват набора, что и автоисправление раскладки. Включите автоисправление раскладки в разделе Ultra Switch."
          }
        }
      }
    },
    "snippetsNewTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New Snippet"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новый сниппет"
          }
        }
      }
    },
