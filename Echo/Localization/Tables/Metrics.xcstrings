    "molePreviewDryRun": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Preview (dry-run)" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Предпросмотр (dry-run)" } }
