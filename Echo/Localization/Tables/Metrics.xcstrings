    },
    "moleRunInTerminal": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Run in Terminal" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Запустить в Terminal" } }
      }
    },
    "moleDryRunExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "“Preview” runs the command with --dry-run: Mole only shows what would be removed, without changing anything. “Run” executes it for real. Both open in Terminal — you confirm there and enter sudo/Touch ID if needed." } },
        "ru": { "stringUnit": { "state": "translated", "value": "«Preview» запустит команду с --dry-run: Mole только покажет, что будет удалено, ничего не меняя. «Run» выполнит реально. Обе откроются в Terminal — там вы подтвердите действия и при необходимости введёте sudo/Touch ID." } }
      }
    },
    "moleInteractiveExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Opens in Terminal — Mole shows an interactive overview." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Откроется в Terminal — Mole покажет интерактивный обзор." } }
      }
    },
